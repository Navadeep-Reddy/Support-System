# Local Docker demo databases only; do not use these credentials in production.
DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support_agent
TEST_DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support_agent_test

# Required for NVIDIA model/embedding calls (and KB seeding/indexing).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
EMBEDDING_DIMENSIONS=2048

# Used to sign demo-session cookies. Set a random secret outside source control.
SESSION_SECRET=replace-with-a-random-local-secret
SESSION_COOKIE_NAME=support_demo_session
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Optional LangSmith tracing; API key is required only when tracing is enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aatra-support-agent

# Agent/retrieval runtime limits.
HISTORY_TOKEN_BUDGET=8192
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SIMILARITY=0.35
MAX_RETRIEVAL_CALLS=3
MAX_LLM_CALLS=8
MAX_TOOL_CALLS=6
MAX_CONSECUTIVE_TOOL_FAILURES=2
MAX_PROVIDER_RETRIES=2
LLM_TIMEOUT_SECONDS=60
ACTIVE_TURN_DEADLINE_SECONDS=120
